{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/portfolio/browser",
  "redirects": [
    {
      "source": "/:secao(skills|experiencias|projeto-4|projeto-5|certificacoes)/:pagina(\\d+)",
      "destination": "/:secao",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.csr.html"
    }
  ]
}
